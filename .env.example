# Store the real token in the active Hermes profile's .env, not in this file.
YANDEX_MESSENGER_TOKEN=

# Hermes gateway authorization. Prefer an explicit comma-separated login list.
YANDEX_MESSENGER_ALLOWED_USERS=
YANDEX_MESSENGER_ALLOW_ALL_USERS=false

# Optional cron / detached-delivery target:
#   login:alice@example.org
#   chat:0/0/4f24b544-697c-4e18-a9c1-b39432ee9bf9
YANDEX_MESSENGER_HOME_CHANNEL=

# Required only when gateway.platforms.yandex_messenger.extra.transport=webhook.
# Generate at least 32 random bytes; this value becomes part of the URL path.
YANDEX_MESSENGER_WEBHOOK_SECRET=
